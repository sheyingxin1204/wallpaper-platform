# TiDB Cloud connection string copied from the TiDB Cloud "Connect" dialog.
# The TiDB Serverless Driver sends queries over HTTPS, so it works in both
# local Node.js tools and the Cloudflare Worker without a TCP connection pool.
DATABASE_URL=""

# Cloudflare R2 S3-compatible API configuration
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="wallpapers"
# Optional custom public domain. The app defaults to private, short-lived
# presigned downloads when this is empty.
R2_PUBLIC_BASE_URL=""

# Better Auth. Use a random value with at least 32 characters in every environment.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Crawler safety settings. Keep this list limited to sources with explicit
# permission to download and redistribute.
CRAWLER_ALLOWED_HOSTS=""
CRAWLER_USER_AGENT="WallpaperPlatformCrawler/1.0 (+https://example.com/contact)"

# Cloudflare deployment (set as GitHub Actions secrets, never commit values).
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
