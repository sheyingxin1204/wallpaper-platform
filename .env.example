# TiDB Cloud Starter/Essential connection string copied from the TiDB Cloud "Connect" dialog.
# It is MySQL-compatible and must use TLS in production.
DATABASE_URL=""
DATABASE_SSL="true"
# Leave empty for TiDB Cloud Starter/Essential. For Dedicated, paste the CA PEM on one line with \n escapes.
DATABASE_SSL_CA=""

# Cloudflare R2 S3-compatible API configuration
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="wallpapers"
R2_PUBLIC_BASE_URL=""

# Better Auth. Use a random value with at least 32 characters in every environment.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
